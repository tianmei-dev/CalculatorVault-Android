    <string name="agreement_service_title">一、服务说明</string>
    <string name="agreement_service_body">隐藏计算器提供本地计算器及后续的本地隐私工具能力。本阶段不提供账号、云同步或远程服务。</string>
    <string name="agreement_behavior_title">二、用户行为要求</string>
    <string name="agreement_behavior_body">请合法、合理使用本应用，不得利用应用存储或处理违法违规内容。</string>
    <string name="agreement_local_title">三、本地数据说明</string>
    <string name="agreement_local_body">应用初始化状态和密码哈希材料保存在当前设备本地。卸载应用或清除应用数据可能导致这些数据丢失。</string>
    <string name="agreement_risk_title">四、风险提示</string>
    <string name="agreement_risk_body">移动设备损坏、系统清理或用户误操作可能造成数据不可恢复，请自行妥善管理设备。</string>
    <string name="agreement_contact_title">五、联系方式</string>
    <string name="agreement_contact_body">开发者：四川极光软件科技有限公司。正式联系渠道将在应用上架前补充完善。</string>
    <string name="agreement_effective_date">生效日期：2026 年 7 月 28 日</string>
    <string name="privacy_collection_title">一、收集的信息</string>
    <string name="privacy_collection_body">MVP 当前不要求登录，不收集账号信息，也不将密码明文保存或上传。初始化仅在本地保存隐私同意记录及密码哈希材料。</string>
    <string name="privacy_permission_title">二、权限使用</string>
    <string name="privacy_permission_body">当前版本不申请联系人、位置、相册、已安装应用列表等敏感权限。</string>
    <string name="privacy_storage_title">三、本地存储</string>
    <string name="privacy_storage_body">隐私同意状态、协议版本、确认时间、随机盐值及密码哈希保存在应用专属 DataStore 中。</string>
    <string name="privacy_sdk_title">四、第三方 SDK</string>
    <string name="privacy_sdk_body">当前 MVP 未接入广告、统计、登录、支付或其他第三方业务 SDK。</string>
    <string name="privacy_deletion_title">五、数据删除</string>
    <string name="privacy_deletion_body">卸载应用或通过系统设置清除应用数据，可删除当前设备上的应用本地数据。本阶段不提供云端数据。</string>
    <string name="privacy_contact_title">六、联系方式</string>
    <string name="privacy_contact_body">开发者：四川极光软件科技有限公司。正式联系渠道将在应用上架前补充完善。</string>
