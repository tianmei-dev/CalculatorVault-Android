<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CalculatorVault" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/vault_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.CalculatorVault.ShortcutEntry" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/vault_background</item>
        <item name="android:windowBackground">@color/vault_background</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
